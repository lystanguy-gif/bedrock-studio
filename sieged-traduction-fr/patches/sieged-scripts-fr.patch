+// ============================================================
+world.beforeEvents.playerInteractWithEntity.subscribe((ev) => {
+    const player = ev.player;
+    const target = ev.target;
+    const item   = ev.itemStack;
+    if (!item || item.typeId !== SCROLL_ID) return;
+    if (!target || target.typeId !== "minecraft:parrot") return;
+    // Responding to a declaration or proposing peace is handled by the
+    // scroll's itemUse flow — keep the same precedence as the crow scan.
+    if (player.getTags().some(t => t.startsWith(HAS_DECLARATION_PFX) || t.startsWith(AT_WAR_PFX))) return;
+
+    ev.cancel = true;
+    system.run(() => {
+        if (!target.isValid || !player.isValid) return;
+        const dim      = target.dimension;
+        const spawnLoc = { ...target.location };
+
+        // Consume one scroll from the main hand (parity with the thrown flow)
+        try {
+            const equip = player.getComponent("minecraft:equippable");
+            const held  = equip?.getEquipment("Mainhand");
+            if (held?.typeId === SCROLL_ID) {
+                if (held.amount > 1) {
+                    held.amount -= 1;
+                    equip.setEquipment("Mainhand", held);
+                } else {
+                    equip.setEquipment("Mainhand", undefined);
+                }
+            }
+        } catch (_) {}
+
+        target.remove();
+        const crow = dim.spawnEntity(CROW_ID, spawnLoc);
+        player.sendMessage({ rawtext: [{ text: "§6 " }, { translate: "sieged.hud.war_crow_summoned" }] });
+        player.sendMessage({ rawtext: [{ translate: "sieged.hud.war_declare_via_crow" }] });
+
+        system.run(() => openDeclarationPrompt(player, crow));
+    });
+});
