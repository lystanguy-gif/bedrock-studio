# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier .env ne doit JAMAIS etre committe (il est dans .gitignore).

# URL de ton projet Supabase (ex: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Cle "anon public" (ou "publishable") de ton projet Supabase
VITE_SUPABASE_ANON_KEY=

# Email(s) administrateur(s) du site, separes par des virgules (ex: toi@gmail.com)
VITE_ADMIN_EMAILS=
